#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.local/bin:${HOME}/.rbenv/shims:${HOME}/.rbenv/bin:${PATH}"
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash)"
fi

cd "$ROOT/backend"
bin/rails server -p 3000 -b 127.0.0.1 &
rails_pid=$!

cd "$ROOT/frontend"
npm run dev -- --host 127.0.0.1 --port 5173 &
web_pid=$!

trap 'kill "$rails_pid" "$web_pid" 2>/dev/null || true' EXIT INT TERM
wait
